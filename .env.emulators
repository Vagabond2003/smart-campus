# Loaded by `npm run dev:emulated` (vite --mode emulators), and it outranks .env.local.
# The portal talks only to the local Auth and Firestore emulators started by `npm run emulators`,
# under Firebase's offline "demo-" project, so nothing here ever reaches a real Firebase project.
#
# Test account for the emulators (their data is wiped whenever they stop): activate ID
# 2026000000000017, name "Emulator Tester", password emulator-pass-17.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-smart-campus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-smart-campus
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_EMULATORS=true
