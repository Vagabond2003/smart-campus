# Loaded by `npm run dev:offline` (vite --mode offline), and it outranks .env.local: the portal runs
# with no Firebase config at all, on its built-in sample data, exactly as a fresh clone would.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_EMULATORS=false
