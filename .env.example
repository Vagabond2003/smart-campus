# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave these empty to run Smart Campus fully offline on its built-in sample data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: appears once Google Analytics is enabled for the Firebase project.
VITE_FIREBASE_MEASUREMENT_ID=
# Leave false. `npm run dev:emulated` switches to the local emulators itself (see .env.emulators).
VITE_FIREBASE_EMULATORS=false
